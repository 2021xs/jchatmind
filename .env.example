# Copy the variables you need into your local environment or an ignored .env file.
# All credentials below are placeholders.

# Main PostgreSQL datasource
POSTGRES_URL=jdbc:postgresql://localhost:5432/jchatmind
POSTGRES_USER=jchatmind_app
POSTGRES_PASSWORD=replace-with-local-password

# Mandatory independent read-only datasource used by the Agent SQL tool
JCHATMIND_DB_READONLY_URL=jdbc:postgresql://localhost:5432/jchatmind
JCHATMIND_DB_READONLY_USERNAME=jchatmind_readonly
JCHATMIND_DB_READONLY_PASSWORD=replace-with-local-readonly-password

# Planning model providers
ZHIPUAI_API_KEY=replace-with-provider-key
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas
ZHIPUAI_MODEL=glm-4.6
DEEPSEEK_OFFICIAL_API_KEY=replace-with-provider-key
DEEPSEEK_OFFICIAL_BASE_URL=https://api.deepseek.com
DEEPSEEK_OFFICIAL_MODEL=deepseek-chat
GPT_COMPATIBLE_API_KEY=replace-with-provider-key
GPT_COMPATIBLE_BASE_URL=https://api.openai.com/v1
GPT_COMPATIBLE_MODEL=replace-with-compatible-model

# Ollama-compatible embedding endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
CODE_RAG_EMBEDDING_BATCH_SIZE=16
CODE_RAG_INCLUDE_SQL_FILES=false

# Comma-separated scan roots. Keep local imports and GitHub clones below these roots.
CODE_RAG_ALLOWED_ROOTS=./workspace
JCHATMIND_GITHUB_WORKSPACE_ROOT=./workspace
JCHATMIND_GITHUB_CLONE_TIMEOUT=10m
JCHATMIND_GITHUB_MAX_TOTAL_SOURCE_BYTES=209715200
JCHATMIND_GITHUB_MIN_FREE_SPACE_BYTES=0

# Database tool result and timeout bounds
AGENT_DB_TOOL_MAX_ROWS=50
AGENT_DB_TOOL_QUERY_TIMEOUT_SECONDS=5
AGENT_DB_TOOL_FETCH_SIZE=50
AGENT_DB_TOOL_MAX_CELL_CHARS=500
AGENT_DB_TOOL_MAX_RESULT_LENGTH=4000

# This flag controls post-commit TOKEN replay only; validated durable Final remains enabled.
JCHATMIND_WEB_CONSOLE_FINAL_STREAMING_ENABLED=true
